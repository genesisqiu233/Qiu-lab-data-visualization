#install.packages("tidyverse")
#install.packages("readxl")
#install.packages("gt")
#install.packages("scales")
library(tidyverse)
library(readxl)
library(gt)
library(scales)
#| output: FALSE
# Load data
ai_data <- read_csv("global_ai_jobs_2026.csv")
# Inspect data
head(ai_data)
#| output: FALSE
# Extract for only variables Salary, Auto_Risk_Tier, Auto_Risk, Experience, Specs and Industry columns
ai_data_clean <- ai_data |>
filter(Job_Type == "Full-time") |>
rename(
Salary = 'Salary_USD',
Auto_Risk = 'Automation_Risk_%',
Experience = 'Experience_Level',
Specs = 'AI_Specialization',
Size = 'Company_Size',
) |>
mutate(
Experience = factor(
Experience,
levels = c("Entry Level", "Mid Level", "Senior Level", "Lead Level", "Executive")
)) |>
select(Salary, Auto_Risk, Experience, Specs, Industry, Size)
#| output: FALSE
industry_stats <- ai_data_clean |>
group_by(Industry) |>
summarize(
n = n(),
mean_salary = mean(Salary, na.rm = TRUE),
median_salary = median(Salary, na.rm = TRUE),
mean_risk = mean(Auto_Risk, na.rm = TRUE),
r = cor(Auto_Risk, Salary, use = "complete.obs"),
p_val = cor.test(Auto_Risk, Salary)$p.value,
z = atanh(r),
se_z = 1 / sqrt(n - 3),
ci_lower = tanh(z - 1.96 * se_z),
ci_upper = tanh(z + 1.96 * se_z),
.groups = "drop"
) |>
arrange(r) |>
mutate(
Industry = factor(Industry, levels = Industry),
Regime = case_when(
p_val < 0.05 & r < 0 ~ "Wage Penalty (p < .05)",
p_val < 0.05 & r > 0 ~ "Wage Premium (p < .05)",
TRUE ~ "Statistically Unclear"
)
)
#| output: FALSE
fig1a_scientific <- ai_data_clean |>
ggplot(aes(x = Auto_Risk, y = Salary)) +
geom_point(alpha = 0.3, size = 1.2, shape = 1) +
geom_smooth(method = "lm", formula = y ~ x, color = "black", linewidth = 0.8, se = TRUE) +
scale_y_continuous(
labels = label_dollar(scale = 1e-3, suffix = "k"),
breaks = seq(0, 600000, by = 200000)
) +
scale_x_continuous(breaks = seq(5, 40, by = 10)) +
labs(
title = "Figure 1a. Correlation between Annual Salary and Automation Risk",
subtitle = "Points represent individual job listings; shaded regions depict 95% confidence bounds.",
x = "Automation Risk Index (%)",
y = "Annual Salary (USD in Thousands)",
) +
theme_bw(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 11),
strip.background = element_rect(fill = "grey95"),
strip.text = element_text(face = "bold", size = 9),
panel.grid.minor = element_blank()
)
print(fig1a_scientific)
#| output: FALSE
fig1b_scientific <- ggplot(industry_stats, aes(x = r, y = Industry)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "grey30", linewidth = 0.5) +
geom_errorbarh(aes(xmin = ci_lower, xmax = ci_upper),
height = 0.25, color = "black", linewidth = 0.5) +
geom_point(aes(shape = (p_val < 0.05)), size = 2, fill = "black") +
scale_shape_manual(
name = "Significance",
values = c("TRUE" = 16, "FALSE" = 1),
labels = c("TRUE" = "p < 0.05", "FALSE" = "p >= 0.05")
) +
scale_x_continuous(
limits = c(-0.4, 0.4),
breaks = seq(-0.4, 0.4, by = 0.1),
labels = label_number(accuracy = 0.1)
) +
labs(
title = "Figure 1b. Sector-Specific Correlation Between Automation Risk and Compensation",
subtitle = expression(paste("Pearson correlation coefficients (", italic("r"), ") with 95% confidence intervals across 28 industries (", italic("N"), " = 3,952).")),
x = expression(paste("Correlation Coefficient (", italic("r"), ")")),
y = "Industry Sector",
caption = "Note: Solid markers denote statistical significance at alpha = 0.05 (two-tailed test)."
) +
theme_classic(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 11, hjust = 0),
plot.subtitle = element_text(size = 9, margin = margin(b = 8)),
axis.text.y = element_text(size = 8),
legend.position = "bottom",
panel.grid.major.x = element_line(color = "grey90", linewidth = 0.3)
)
print(fig1b_scientific)
#| output: FALSE
fig1b_scientific <- ggplot(industry_stats, aes(x = r, y = Industry)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "grey30", linewidth = 0.5) +
geom_errorbarh(aes(xmin = ci_lower, xmax = ci_upper),
height = 0.25, color = "black", linewidth = 0.5) +
geom_point(aes(shape = (p_val < 0.05)), size = 2, fill = "black") +
scale_shape_manual(
name = "Significance",
values = c("TRUE" = 16, "FALSE" = 1),
labels = c("TRUE" = "p < 0.05", "FALSE" = "p >= 0.05")
) +
scale_x_continuous(
limits = c(-0.4, 0.4),
breaks = seq(-0.4, 0.4, by = 0.1),
labels = label_number(accuracy = 0.1)
) +
labs(
title = "Figure 1b. Sector-Specific Correlation Between Automation Risk and Compensation",
subtitle = expression(paste("Pearson correlation coefficients (", italic("r"), ") with 95% confidence intervals across 28 industries (", italic("N"), " = 3,952).")),
x = expression(paste("Correlation Coefficient (", italic("r"), ")")),
y = "Industry Sector",
caption = "Note: Solid markers denote statistical significance at alpha = 0.05 (two-tailed test)."
) +
theme_classic(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 11, hjust = 0),
plot.subtitle = element_text(size = 9, margin = margin(b = 8)),
axis.text.y = element_text(size = 8),
legend.position = "bottom",
panel.grid.major.x = element_line(color = "grey90", linewidth = 0.3)
)
print(fig1b_scientific)
#| output: FALSE
focal_industries <- c("Research & Development", "Insurance")
fig1c_scientific <- ai_data_clean |>
filter(Industry %in% focal_industries) |>
mutate(Industry = factor(Industry, levels = focal_industries)) |>
ggplot(aes(x = Auto_Risk, y = Salary)) +
geom_point(alpha = 0.3, size = 1.2, shape = 1) +
geom_smooth(method = "lm", formula = y ~ x, color = "black", linewidth = 0.8, se = TRUE) +
facet_wrap(~ Industry, ncol = 2, scales = "fixed") +
scale_y_continuous(
labels = label_dollar(scale = 1e-3, suffix = "k"),
breaks = seq(0, 600000, by = 200000)
) +
scale_x_continuous(breaks = seq(5, 40, by = 10)) +
labs(
title = "Figure 1c. Linear Marginal Effects of Automation Risk on Compensation",
subtitle = "Points represent individual job listings; shaded regions depict 95% confidence bounds.",
x = "Automation Risk Index (%)",
y = "Annual Salary (USD in Thousands)",
) +
theme_bw(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 11),
strip.background = element_rect(fill = "grey95"),
strip.text = element_text(face = "bold", size = 9),
panel.grid.minor = element_blank()
)
print(fig1c_scientific)
#| output: FALSE
seniority <- ai_data_clean |>
group_by(Experience) |>
summarize(
mean_salary  = mean(Salary),
mean_risk = mean(Auto_Risk),
n = n()
)
fig2a_scientific <- ggplot(seniority, aes(x = Experience, y = mean_salary)) +
geom_col(fill = "#37474F", width = 0.55) +
geom_text(
aes(label = paste0(dollar(round(mean_salary)), "\n(Risk: ", round(mean_risk, 1), "%)")),
vjust = -0.3, size = 3.2
) +
scale_y_continuous(labels = dollar_format(), limits = c(0, 400000)) +
labs(
title = "Figure 2a: The Seniority Shield (Compensation for Automation Risk)",
subtitle = "Salaries increase 4.7x across ranks, while automation exposure remains static at ~23%.",
x = "Experience Level",
y = "Average Annual Salary (USD)",
caption = "Full-time positions (N = 3,952). Mean automation risk is annotated above each tier."
) +
theme_minimal(base_size = 11) +
theme(panel.grid.minor = element_blank())
print(fig2a_scientific)
#| output: FALSE
spec_summary <- ai_data_clean |>
group_by(Specs) |>
summarize(
mean_salary  = mean(Salary),
mean_risk = mean(Auto_Risk),
n = n()
) |>
arrange(desc(mean_salary))
fig2b_scientific <- ggplot(spec_summary, aes(x = reorder(Specs, mean_salary), y = mean_salary)) +
geom_point(size = 4, color = "#00838F") +
geom_segment(aes(x = Specs, xend = Specs, y = 140000, yend = mean_salary), color = "grey60") +
coord_flip() +
scale_y_continuous(labels = dollar_format(), limits = c(140000, 170000)) +
labs(
title = "Figure 2b: Compensation Parity Across AI Disciplines",
subtitle = "Generative AI ($160k) offers no substantial wage premium over Computer Vision ($159k) or Machine Learning ($155k).",
x = "AI Specialization",
y = "Average Salary (USD)",
caption = "Baseline truncated at $140k to highlight discipline dispersion."
) +
theme_minimal(base_size = 11) +
theme(panel.grid.minor = element_blank())
print(fig2b_scientific)
#| output: FALSE
size_summary <- ai_data_clean |>
group_by(Size) |>
summarize(
mean_salary  = mean(Salary),
median_salary = median(Salary),
n = n()
)
fig2c_scientific <- ggplot(size_summary, aes(x = Size, y = mean_salary)) +
geom_col(fill = "#5D4037", width = 0.5) +
geom_text(aes(label = dollar(round(mean_salary))), vjust = 1.5, color = "white", fontface = "bold", size = 3.5) +
scale_y_continuous(labels = dollar_format()) +
labs(
title = "Figure 2c: Small Startups Pay Higher Base Cash Salaries",
subtitle = "Boutique firms (1-50 employees) offer $160.7k on average to compete against Enterprise giants ($156.7k).",
x = "Firm Headcount Tier",
y = "Mean Base Salary (USD)",
caption = "N = 3,952 full-time AI jobs."
) +
theme_minimal(base_size = 11) +
theme(panel.grid.minor = element_blank())
print(fig2c_scientific)
#| output: FALSE
industry_summary <- industry_stats |>
mutate(
Regime = case_when(
r > 0.05  ~ "Risk Premium (Higher Risk, Higher Pay)",
r < -0.05 ~ "Wage Penalty (Higher Risk, Lower Pay)",
TRUE                ~ "Neutral"
)
)
fig3a_accessible <- ggplot(industry_summary,
aes(x = reorder(Industry, r), y = r, fill = Regime)) +
geom_col(width = 0.6) +
geom_hline(yintercept = 0, linetype = "solid", color = "gray50", linewidth = 0.5) +
coord_flip() +
scale_fill_manual(
values = c(
"Risk Premium (Higher Risk, Higher Pay)" = "#2E7D32",
"Wage Penalty (Higher Risk, Lower Pay)"   = "#C62828"
)
) +
labs(
title = "The Industry Split: Who Compensates for Automation Risk?",
subtitle = "In Insurance, exposed roles earn more. In R&D, automatable roles take a pay cut.",
x = "",
y = "Correlation Between Automation Risk and Salary",
fill = "Market Dynamic",
caption = "Data: 2026 Global AI Jobs Report (Full-time roles only)"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", size = 13, color = "#111111"),
plot.subtitle = element_text(size = 10, color = "#444444", margin = margin(b = 12)),
legend.position = "top",
legend.title = element_text(face = "bold", size = 9),
legend.text = element_text(size = 8),
panel.grid.minor = element_blank(),
axis.text = element_text(color = "#222222")
)
print(fig3a_accessible)
#| output: FALSE
fig3b_accessible <- ggplot(ai_data_clean, aes(x = Auto_Risk, y = Salary, color = Experience)) +
geom_point(alpha = 0.25, size = 1.5) +
geom_smooth(method = "lm", se = FALSE, linewidth = 1.2) +
scale_y_continuous(labels = dollar_format(scale = 0.001, suffix = "k")) +
scale_x_continuous(labels = percent_format(scale = 1)) +
scale_color_brewer(palette = "Set1") +
labs(
title = "Seniority is the True Salary Driver, Not Automation Exposure",
subtitle = "Salaries follow rigid experience tiers; higher automation risk does not erode executive or lead wages.",
x = "Estimated Automation Risk (%)",
y = "Annual Salary (USD)",
color = "Career Stage",
caption = "Trend lines represent linear regressions across 3,952 full-time AI jobs."
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", size = 13, color = "#111111"),
plot.subtitle = element_text(size = 10, color = "#444444", margin = margin(b = 12)),
legend.position = "right",
legend.title = element_text(face = "bold", size = 10),
panel.grid.minor = element_blank()
)
print(fig3b_accessible)
