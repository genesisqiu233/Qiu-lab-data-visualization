```{r, clean data}
#| output: FALSE

# Extract for only variables Gender, Age group, Relationship Status, Ethnicity and survery response column
# Mutate to convert survey response column to integers

aad.clean <- data |>
    mutate(Gender = case_when(`Gender`==1 ~ "Male", `Gender`==2 ~"Female", TRUE ~ "NA")) |> 
    mutate(Age.Group = case_when(`Age group`==1 ~ "18-24", `Age group`==2 ~ "25-34", `Age group`==3 ~ "35-44", `Age group`==4 ~ "45-54", `Age group`==5 ~ "55-64", TRUE ~ "NA")) |>
    mutate(Relationship.Status = case_when(`Relationship`==1 ~ "married", `Relationship`==2 ~ "in a relationship", `Relationship`==4 ~ "divorced", `Relationship`==5 ~ "in a relationship", `Relationship`==6 ~ "never been in a relationship", `Relationship`==7 ~ "prefer not to say", TRUE ~ "NA")) |>
    mutate(Ethnicity = case_when(`Ethnicity`==1 ~ "white/Caucasian", `Ethnicity`==2 ~ "Asian/Asian British", `Ethnicity`==5 ~ "Other ethnic group", `Ethnicity`==6 ~ "prefer not to say", TRUE ~ "NA")) |>
    select(Gender, Age.Group, Relationship.Status, Ethnicity, SA_1:SEst_10) |>
    mutate_at(5:43, as.integer)
```

```{r, score items}
#| output: FALSE

# Answer key: which items belong to each subscale.
# "-" marks reverse-coded items

keys.SA<- list(SA=c("SA_1", "SA_2", "SA_3","SA_4","-SA_5", "SA_6", "SA_7", "SA_8", "-SA_9", "SA_10", "-SA_11", "SA_12", "SA_13", "SA_14", "SA_15", "SA_16", "SA_17", "SA_18", "SA_19", "SA_20"))
keys.AA<- list(AA=c("AA_1", "AA_2", "AA_3","AA_4","AA_5", "AA_6", "AA_7", "AA_8", "AA_9"))
keys.SEst<- list(SEst=c("SEst_1", "-SEst_2", "SEst_3","SEst_4","-SEst_5", "-SEst_6", "SEst_7", "-SEst_8", "-SEst_9", "SEst_10"))

# Average items per person, and compute Cronbach's alpha.
# Returns $scores (per-person scores as averages since we set totals to F) and $alpha (reliability)
scores.SA<-scoreItems(keys.SA, aad.clean, totals = F, min=1, max=4)
scores.AA<-scoreItems(keys.AA, aad.clean, totals = F, min=1, max=7)
scores.SEst<-scoreItems(keys.SEst, aad.clean, totals = F, min=1, max=4)
# Turn this into a dataframe!
scores_scale1.df<-as.data.frame(scores.SA$scores)
scores_scale2.df<-as.data.frame(scores.AA$scores)
scores_scale3.df<-as.data.frame(scores.SEst$scores)
```

```{r, combine data frames}
#| output: FALSE

# Combine the original data set with the new scores dataframe
allscores.df<-cbind(scores_scale1.df, scores_scale2.df, scores_scale3.df)
aad.clean<-cbind(aad.clean, allscores.df)
# Inspect new data set
head(aad.clean)
```

